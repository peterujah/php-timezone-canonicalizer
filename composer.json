{
    "name": "peterujah/php-timezone-canonicalizer",
    "description": "Lightweight PHP library that resolves backward-compatible IANA timezone aliases (e.g. Asia/Calcutta) to their canonical identifiers (e.g. Asia/Kolkata).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "timezone",
        "time zone",
        "iana",
        "tzdata",
        "tz database",
        "alias",
        "canonical",
        "datetimezone",
        "php"
    ],
    "require": {
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "Peterujah\\Timezone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Peterujah\\Timezone\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
        "phpstan/phpstan": "^1.10 || ^2.0"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "analyse": "Run PHPStan static analysis.",
        "check": "Run static analysis and the test suite."
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
